          <mxGeometry x="370" y="20" width="160" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== Google Gemini TTS (外部クラウド) ===== -->
        <mxCell id="gemini" value="Google Gemini TTS API&#xa;(クラウド 音声合成)"
